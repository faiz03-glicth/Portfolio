# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public origin of the deployed site. Used for canonical URLs, Open Graph
# images, sitemap.xml and robots.txt. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# local | development | testing | production
# Drives feature flags and logging verbosity in src/config/app.ts.
NEXT_PUBLIC_APP_ENV=local

# ---------------------------------------------------------------------------
# Later branches append their own variables to this file:
#   database    -> NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
#                  SUPABASE_SERVICE_ROLE_KEY
#   integration -> SPOTIFY_*, GITHUB_TOKEN, GITLAB_TOKEN
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Supabase  (branch: database)
#
# All three are optional. With none of them set the site renders the static
# content in src/data/ — the database is an upgrade, not a dependency.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable key. Public by design: it is shipped in the browser
# bundle, and Row Level Security is what actually constrains it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. Bypasses Row Level Security completely.
# SERVER ONLY — never prefix this with NEXT_PUBLIC_, never read it from a
# Client Component. src/lib/supabase/server.ts is marked `server-only` so an
# accidental client import fails the build instead of leaking the key.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Spotify  (branch: integration)
#
# All three are required together, or the Recently Played section falls back
# to sample tracks. Create an app at https://developer.spotify.com/dashboard
#
# The refresh token is obtained once, by hand:
#   npm run spotify:token
# See docs/integrations.md.
# ---------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Long-lived. Scoped to user-read-recently-played only — it does not need, and
# should not be granted, playback or library write scopes.
SPOTIFY_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# GitHub  (branch: integration)
# ---------------------------------------------------------------------------

# Whose profile to show. This alone enables the integration — public
# repositories are readable without a token.
GITHUB_USERNAME=

# OPTIONAL. Raises the rate limit from 60 to 5,000 requests/hour and unlocks
# the contribution calendar, which only exists in the GraphQL API.
#
# A fine-grained token with NO scopes and no repository access is sufficient —
# it only needs to authenticate, not to authorise anything. Do not use a
# classic token with repo scope.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# GitLab  (branch: integration)
# ---------------------------------------------------------------------------
GITLAB_USERNAME=

# OPTIONAL. Raises rate limits and exposes the event feed used to approximate
# a contribution calendar.
#
# Scope: read_api only. Not `api`, which grants write access.
GITLAB_TOKEN=

# OPTIONAL. Override for a self-hosted instance. Defaults to https://gitlab.com
GITLAB_BASE_URL=
