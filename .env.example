# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public origin of the deployed site. Used for canonical URLs, Open Graph
# images, sitemap.xml and robots.txt. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# local | development | testing | production
# Drives feature flags and logging verbosity in src/config/app.ts.
NEXT_PUBLIC_APP_ENV=local

# ---------------------------------------------------------------------------
# Later branches append their own variables to this file:
#   database    -> NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
#                  SUPABASE_SERVICE_ROLE_KEY
#   integration -> SPOTIFY_*, GITHUB_TOKEN, GITLAB_TOKEN
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Supabase  (branch: database)
#
# All three are optional. With none of them set the site renders the static
# content in src/data/ — the database is an upgrade, not a dependency.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable key. Public by design: it is shipped in the browser
# bundle, and Row Level Security is what actually constrains it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. Bypasses Row Level Security completely.
# SERVER ONLY — never prefix this with NEXT_PUBLIC_, never read it from a
# Client Component. src/lib/supabase/server.ts is marked `server-only` so an
# accidental client import fails the build instead of leaking the key.
SUPABASE_SERVICE_ROLE_KEY=
